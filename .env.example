ENABLE_OTEL=1
ENABLE_OTEL_SENSITIVE=1
ENABLE_LLM_ASSISTANT_PREVIEW=1
LLM_PREVIEW_CHARS=1200
LLM_PREVIEW_ONLY_WHEN_NO_TOOLS=0
ENABLE_OTEL_RAW=1

# Phase selection per run: phase1 or phase2_1
AGENT_PHASE=phase1

# Provider selection per run: ollama or openrouter
LLM_PROVIDER=ollama

# Local Ollama default
AGENT_MODEL=qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434/

# OpenRouter setup
# LLM_PROVIDER=openrouter
# AGENT_MODEL=openai/gpt-4.1-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
