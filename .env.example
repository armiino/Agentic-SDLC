# Local endpoints and secrets only.
# Run settings such as phase, model, provider and observability live in run-config.json.
#
# Kopiere diese Datei nach `.env` (gitignored) und fuelle die Werte ein.
# Ohne diese Datei laufen Build, Tests und `tools/smoke-hitl.sh` trotzdem — sie brauchen kein Netz.

# --- LLM ---
# Pflicht fuer jeden Lauf, der ein Modell aufruft (Anbieter/Modell stehen in run-config.json).
OLLAMA_BASE_URL=http://localhost:11434/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- GitHub (Tor 3) ---
# Welche Variable gelesen wird, bestimmt run-config.json -> fullworkflow.tokenEnv.
# Dort steht derzeit GITHUB_AGENTIC_REFACTOR_TOKEN fuer das Repo fullworkflow.repo.
GITHUB_AGENTIC_REFACTOR_TOKEN=

# Rueckfall, wenn fullworkflow.tokenEnv leer ist: erst GITHUB_TEST_TOKEN, dann githubtoken
# (GithubForwardApply.ResolveToken). Beim Snapshot greift der githubtoken-Rueckfall nur,
# wenn tokenEnv woertlich "GITHUB_TEST_TOKEN" ist.
GITHUB_TEST_TOKEN=

# Nur fuer das Live-Lesen ueber den github-mcp-server (Steward, readonly). Dessen Reihenfolge:
# GITHUB_AGENTIC_REFACTOR_TOKEN -> GITHUB_TEST_TOKEN -> GITHUB_TOKEN (GithubMcp.ResolveToken).
# Fehlt der Token, faellt das Live-Lesen still aus; alles andere laeuft weiter.
GITHUB_TOKEN=
