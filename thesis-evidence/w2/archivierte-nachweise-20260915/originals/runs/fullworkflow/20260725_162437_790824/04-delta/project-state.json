      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-15",
      "itemType": "requirement",
      "text": "Es ist noch offen, ob Angeh\u00F6rige im System selbst Inhalte eintragen d\u00FCrfen oder nur lesend zugreifen k\u00F6nnen; Datenschutzfragen dazu sind noch zu kl\u00E4ren.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_162645_5b0d1b",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
