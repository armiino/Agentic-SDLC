    },
    {
      "itemId": "REQ-17",
      "itemType": "requirement",
      "text": "Ein Dunkelmodus f\u00FCr den Nachtdienst und eine einstellbare Schriftgr\u00F6\u00DFe f\u00FCr \u00E4ltere Kolleginnen sind als sp\u00E4tere Verbesserungen w\u00FCnschenswert, aber nicht zwingend erforderlich im MVP.",
      "status": "baseline",
