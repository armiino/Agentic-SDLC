      "pbi": null
    },
    {
      "itemId": "REQ-14",
      "itemType": "requirement",
      "text": "Die App unterst\u00FCtzt im MVP mindestens Android 10; \u00E4ltere Ger\u00E4te im Haus m\u00FCssen gegebenenfalls ausgetauscht werden.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_162645_5b0d1b",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
