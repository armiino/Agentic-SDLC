      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-16",
      "itemType": "requirement",
      "text": "Die Piktogramme sollten in einem gr\u00F6\u00DFeren Kontext weitergedacht und erweitert werden, um ihre Wirkung zu verbessern; wie dies geschehen soll, ist noch unklar.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_162645_5b0d1b",
      "sourceArtifactId": "REQ",
