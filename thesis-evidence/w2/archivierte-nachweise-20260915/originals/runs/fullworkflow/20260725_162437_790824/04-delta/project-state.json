      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-13",
      "itemType": "requirement",
      "text": "Firebase Firestore wird im MVP als Datenbank verwendet; alternative L\u00F6sungen werden nicht weiter diskutiert.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_162645_5b0d1b",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
