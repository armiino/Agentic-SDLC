{
  "runId": "20260906_163431_f0d718",
  "source": "Interview-Einrichtung.txt",
  "model": "openai/gpt-5-mini",
  "variant": "F_mission_v2",
  "statements": [
    {
      "id": "C-001",
      "statement": "Die Einrichtung betreut Einrichtungen und Wohngemeinschaften f\u00FCr Menschen mit Beeintr\u00E4chtigungen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0001"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-002",
      "statement": "Bewohner haben unterschiedliche Beeintr\u00E4chtigungen und werden meistens nur von langj\u00E4hrigen Mitarbeitenden verstanden.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0001"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-003",
      "statement": "Die Mitarbeitenden sind \u00FCberwiegend ausgebildete Heilerziehungspfleger, P\u00E4dagogen oder Krankenpfleger.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0001"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-004",
      "statement": "Bei den Bewohnern gibt es Personen, die nur verbal in einer individuellen, eigenst\u00E4ndigen Sprache kommunizieren beziehungsweise nur nonverbal mittels Geb\u00E4rden oder \u00E4hnlichen Gesten.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0001"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-005",
      "statement": "Die Einrichtung bevorzugt eine digitale L\u00F6sung (z. B. ein Computerprogramm) zur Unterst\u00FCtzung der Kommunikation.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0001",
        "AU-0024"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-006",
      "statement": "Durch das Digiprosa-Projekt ergab sich eine M\u00F6glichkeit zur Weiterentwicklung, die die Einrichtung ergriffen hat.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0003"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-007",
      "statement": "Kommunikation ist im Alltag der Einrichtung eine der wichtigsten Aufgaben und erfolgt t\u00E4glich.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0003"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-008",
      "statement": "Das Projektteam wird eine Anforderungsanalyse mit Nutzenden und Beteiligten durchf\u00FChren, um Bed\u00FCrfnisse und Systemfunktionen zu ermitteln.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0002",
        "AU-0006",
        "AU-0004"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-009",
      "statement": "Die Idee, ein Ger\u00E4t/System zu bauen, das allgemeine Sprache in das individuell verstehbare Sprachverst\u00E4ndnis eines Bewohners umwandelt (bidirektionaler individueller \u00DCbersetzer), wird als nicht praktikabel und nicht kosteneffizient ausgeschlossen (verworfen).",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0004"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-010",
      "statement": "Das Team besteht aus zwei Informatikern und zwei Sozialarbeitsstudierenden und deckt damit technisches sowie p\u00E4dagogisch-soziales Fachwissen ab.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0006"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-011",
      "statement": "\u00DCber die Bewohner werden klassische Akten gef\u00FChrt, in denen Informationen dokumentiert werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0007"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-012",
      "statement": "Erfahrungen und neues Wissen werden schriftlich dokumentiert, aber einige Mitarbeitende lesen die Dokumentation nicht regelm\u00E4\u00DFig, weil sie zu umfangreich ist und gesuchte Informationen schwer zu finden sind.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0018"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-013",
      "statement": "Neue Mitarbeitende werden \u00FCblicherweise eingearbeitet, indem sie anf\u00E4nglich mit erfahrenen Mitarbeitenden zusammenarbeiten, bis Vertrauen und gegenseitiges Verst\u00E4ndnis aufgebaut sind; erfahrene Mitarbeitende erkl\u00E4ren Bedeutungen von Verhaltensweisen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0021",
        "AU-0022"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-014",
      "statement": "Das Einsehen von Bewohnerakten kann aufgrund datenschutzrechtlicher Einschr\u00E4nkungen problematisch sein; die Einrichtung will pr\u00FCfen, ob Akten gezeigt werden d\u00FCrfen.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0020",
        "AU-0019"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-015",
      "statement": "Vorgeschlagen wird eine App, die Informationen dar\u00FCber enth\u00E4lt, wie eine beeintr\u00E4chtigte Person kommuniziert (als Hilfsmittel f\u00FCr Betreuende, die die Person nicht verstehen).",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0012",
        "AU-0014"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-016",
      "statement": "Die App soll erweiterbar sein und optional Funktionen wie Medikamentenverwaltung und Terminkalender enthalten; eine digitale Gesamtdokumentation ist denkbar, aber wird hinsichtlich Umfang mit Vorsicht betrachtet.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0013",
        "AU-0014",
        "AU-0024",
        "AU-0025"
      ],
      "derivation": "derived",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-017",
      "statement": "Das \u0027About Me\u0027-Modul soll einen ersten Eindruck vermitteln (Name, Alter, Hobbys) und eine Social\u2011Media-\u00E4hnliche Bildtimeline bieten, in der neue Bilder mit Beschreibungen hinzugef\u00FCgt werden k\u00F6nnen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0012",
        "AU-0033",
        "AU-0047",
        "AU-0125",
        "AU-0126"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-018",
      "statement": "Die Kommunikationsseite soll in verbal und nonverbal unterteilt werden und dort Kommunikationsarten als Texte, Bilder und Videos dokumentiert werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0033",
        "AU-0049",
        "AU-0053",
        "AU-0074",
        "AU-0075"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-019",
      "statement": "In allen inhaltlichen Listen (Bilder, Kommunikationsarten, Videos, No\u2011Go) soll ein Plus\u2011Button vorhanden sein, \u00FCber den neue Eintr\u00E4ge (Bilder, Texte, Videos, No\u2011Gos) hinzugef\u00FCgt werden k\u00F6nnen; neueste Eintr\u00E4ge sollen oben angezeigt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0033",
        "AU-0047",
        "AU-0053",
        "AU-0123"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-020",
      "statement": "Es soll eine No\u2011Go\u2011Seite geben, auf der Verhaltensweisen oder Reize festgehalten werden, die in Gegenwart eines Bewohners unbedingt vermieden werden m\u00FCssen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0039",
        "AU-0034",
        "AU-0040",
        "AU-0055",
        "AU-0128"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-021",
      "statement": "Angeh\u00F6rige sollen Zugriff und eigene Accounts erhalten k\u00F6nnen und dort Informationen erg\u00E4nzen, weil Angeh\u00F6rige h\u00E4ufig zus\u00E4tzliche Kenntnisse \u00FCber die Bewohner haben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0034",
        "AU-0036",
        "AU-0037",
        "AU-0077",
        "AU-0078"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-022",
      "statement": "Es sollen verschiedene Account\u2011Typen mit differenzierten Rechten existieren (mindestens Admin, User, Bewohner); Admins k\u00F6nnen Accounts anlegen und verwalten, User k\u00F6nnen Inhalte hinzuf\u00FCgen, aber nicht l\u00F6schen, Bewohner haben eingeschr\u00E4nkte Rechte.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0043",
        "AU-0044",
        "AU-0079",
        "AU-0080",
        "AU-0088",
        "AU-0060",
        "AU-0061"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-023",
      "statement": "Registrierung durch Endnutzer soll deaktiviert werden; nur ein Admin\u2011Account darf neue Accounts erstellen, um unbefugten Zugang und Datenschutzrisiken zu minimieren.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0044",
        "AU-0060",
        "AU-0087",
        "AU-0088"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-024",
      "statement": "Zugriffsrechte sollen auf Einrichtungsebene eingeschr\u00E4nkt werden, sodass Mitarbeitende nur Profile der Bewohner sehen, die in ihrer konkreten Einrichtung leben.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0061",
        "AU-0063",
        "AU-0064"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-025",
      "statement": "Die App soll plattform\u00FCbergreifend laufen (iOS und Android) und daf\u00FCr eine cross\u2011platform Programmiersprache/Framework nutzen.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0065",
        "AU-0066",
        "AU-0066"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-026",
      "statement": "Es ist erw\u00FCnscht, die App auch auf Tablets zu betreiben, um die Nutzung in Einrichtungen zu erleichtern und Datenschutzfragen einfacher zu managen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0067",
        "AU-0068"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-027",
      "statement": "Eine Suchleiste/Suchfunktion soll in der Profil\u00FCbersicht und idealerweise auch auf Kommunikationsseiten vorhanden sein, um gezielt nach Begriffen wie z. B. K\u00F6rperteilen zu filtern.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0069",
        "AU-0070",
        "AU-0071",
        "AU-0050"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-028",
      "statement": "Es soll ein standardisiertes Beschreibungsmuster f\u00FCr das Hinzuf\u00FCgen von Kommunikationsweisen geben (z. B. zuerst K\u00F6rperteil, dann Interpretation), um sp\u00E4tere Suche und Filterung zu erleichtern.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0071",
        "AU-0085",
        "AU-0050"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-029",
      "statement": "Videos sollen in die Kommunikationsseiten integriert werden (kein separater Videoscreen), sodass Videos direkt mit der jeweiligen verbalen/nonverbalen Kommunikationsart verkn\u00FCpft sind.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0074",
        "AU-0075",
        "AU-0052",
        "AU-0031",
        "AU-0032"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-030",
      "statement": "Bei neuen Uploads im About\u2011Me\u2011Bereich sollen alle verkn\u00FCpften Nutzer der jeweiligen Einrichtung eine Popup\u2011Benachrichtigung erhalten.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0078"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-031",
      "statement": "Bewohner sollen eigene Accounts mit eingeschr\u00E4nkten Rechten erhalten k\u00F6nnen, die nur Zugriff auf ihr eigenes Profil erlauben und das Hinzuf\u00FCgen eigener Bilder erm\u00F6glichen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0079",
        "AU-0080",
        "AU-0082"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-032",
      "statement": "Es wird einen Admin\u2011Screen geben, auf dem Admins Accounts anlegen und die drei Rollen (Admin, User, Bewohner) zuweisen k\u00F6nnen; detaillierte Rechteverwaltung wird sp\u00E4ter definiert.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0088",
        "AU-0043",
        "AU-0060"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-033",
      "statement": "Eine Hilfe/Einf\u00FChrung (Tutorial oder erste Tour) in die App sollte vorhanden sein, um Nutzer beim Eingeben und Finden von Informationen zu unterst\u00FCtzen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0086",
        "AU-0132"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-034",
      "statement": "Barrierefreiheit ist wichtig: gro\u00DFe Schrift, ausreichender Kontrast, Vermeidung ablenkender Animationen; zus\u00E4tzlich sollen Sprachbefehle und alternative Eingabemethoden in Betracht gezogen werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0133",
        "AU-0134",
        "AU-0135"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-035",
      "statement": "Login\u2011Screen: Logo oben, E\u2011Mail\u2011Feld, Passwort\u2011Feld und ein hervorgehobener Login\u2011Button; keine Registrierung auf dem Screen.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0117",
        "AU-0118",
        "AU-0119",
        "AU-0120"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-036",
      "statement": "Nach Login kommt eine Profil\u00FCbersicht mit Suche oben; darunter Liste/Kacheln mit Vorschaubild, Name und kurzer Beschreibung; Klick \u00F6ffnet Detailprofil.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0045",
        "AU-0121",
        "AU-0122"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-037",
      "statement": "Die Detailansicht eines Profils zeigt ein gr\u00F6\u00DFeres Profilbild und Hauptbereiche (About Me, Kommunikation, Kalender, No\u2011Go) als interaktive Buttons.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0124",
        "AU-0033"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-038",
      "statement": "About Me: Infobox (Alter, Hobbys etc.) und Foto\u2011Timeline mit Plus\u2011Button; neueste Fotos oben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0125",
        "AU-0047"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-039",
      "statement": "Kommunikationsseite: visuelle Trennung zwischen verbal und nonverbal mit Symbolen; M\u00F6glichkeit, Videos und Beschreibungen per Plus\u2011Button hinzuzuf\u00FCgen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0126",
        "AU-0127",
        "AU-0049",
        "AU-0074"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-040",
      "statement": "No\u2011Go\u2011Screen soll ein deutliches visuelles Warnsymbol (z. B. rotes Stoppschild) und knappe, leicht durchsuchbare Eintr\u00E4ge enthalten.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0128",
        "AU-0055"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-041",
      "statement": "Kalender: Monatsansicht, Termine und Medikamentengaben sichtbar; Icons/Tags f\u00FCr Medikamente und Detailansicht bei Auswahl eines Datums.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0129",
        "AU-0051"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-042",
      "statement": "Es soll eine konsistente Appbar auf jeder Seite geben (links Zur\u00FCck\u2011Pfeil, Mitte Seitentitel, rechts Einstellungen/Logout); Einstellungen sind rollenabh\u00E4ngig.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0054",
        "AU-0120",
        "AU-0130"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-043",
      "statement": "Technologieentscheidungen: Entwicklung mit Flutter und Dart; einheitliche Versionswahl f\u00FCr alle Teammitglieder; empfohlene Entwicklungsumgebungen sind Visual Studio Code oder Android Studio (Team hat Pr\u00E4ferenz f\u00FCr Android Studio).",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0093",
        "AU-0094",
        "AU-0096",
        "AU-0097",
        "AU-0098",
        "AU-0102",
        "AU-0101"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-044",
      "statement": "Datenbank/Backend: Empfehlung f\u00FCr Google Firebase Firestore als Cloud\u2011Datenbank; lokales Caching (z. B. NoSQLite) soll genutzt werden, damit Inhalte nicht bei jedem Zugriff neu geladen werden m\u00FCssen.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0104",
        "AU-0106",
        "AU-0105",
        "AU-0107"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-045",
      "statement": "F\u00FCr Tests soll zun\u00E4chst Android 11 als Ziel im Emulator verwendet werden, da ein echtes Ger\u00E4t mit Android 11 vorhanden ist.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0111",
        "AU-0112"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-046",
      "statement": "Im Projekt soll das JetX\u2011Package erwogen/benutzt werden, um Arbeit zu erleichtern.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0114",
        "AU-0115"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-047",
      "statement": "Die Einholung von Einwilligungen (z. B. f\u00FCr Fotos/Videos) bei Angeh\u00F6rigen wird n\u00F6tig sein; Datenschutzthemen werden separat tiefer zu pr\u00FCfen sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0029",
        "AU-0020",
        "AU-0030",
        "AU-0059",
        "AU-0060"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-048",
      "statement": "Datenschutzma\u00DFnahme: Keine \u00F6ffentliche Registrierung, Accounts nur durch Admins; dies wird als Schutzmechanismus gegen unbefugten Zugriff betrachtet.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0060",
        "AU-0044",
        "AU-0087"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-049",
      "statement": "Die App soll dynamisch wachsen: neue Erfahrungen und Eintr\u00E4ge k\u00F6nnen jederzeit erg\u00E4nzt und innerhalb der Einrichtung geteilt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0023",
        "AU-0077"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-050",
      "statement": "Zielpriorit\u00E4t: L\u00F6sung soll prim\u00E4r Betreuende unterst\u00FCtzen, damit diese Bewohnende besser verstehen; nicht vorrangig Bewohnende, die Betreuende besser verstehen sollen.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0010",
        "AU-0011",
        "AU-0012"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-051",
      "statement": "Es gibt individuelle F\u00E4lle (z. B. \u0027Hubert\u0027), bei denen bestimmte k\u00F6rperliche Bewegungen (z. B. Fu\u00DFbewegungen) eine kommunikative Bedeutung haben, die nur erfahrene Mitarbeitende sofort deuten k\u00F6nnen; Externe verstehen das meist nicht beim ersten Kontakt.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0017",
        "AU-0031",
        "AU-0032"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-052",
      "statement": "Das Team w\u00FCnscht sich einen Kennenlern\u2011 bzw. Beobachtungstag vor Ort, bei dem Mitarbeitende des Projekts mit Heilerziehungspflegern die Situation vor Ort ansehen, um ein umfassenderes Bild zu gewinnen.",
