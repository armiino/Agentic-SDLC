      "proposition": "Es soll eine nur f\u00FCr Admins sichtbare Admin-Seite geben, auf der neue Accounts angelegt und die Rollen Admin, User und Bewohner vergeben werden k\u00F6nnen; die genaue Rechteverwaltung bleibt offen.",
      "status": "desired",
      "modality": "must_consider",
      "scope": "admin-screen und rollenvergabe",
      "segments": [
        87
      ]
    },
    {
      "id": "IE-R080-DATA-CONSISTENCY-STANDARDIZATION",
      "proposition": "Standardisierte Eingabemuster sollen Datenkonsistenz verbessern und eine einheitlichere Nutzererfahrung erm\u00F6glichen.",
      "status": "desired",
      "modality": "must_consider",
      "scope": "datenkonsistenz und ux-standardisierung",
      "segments": [
        86
      ]
    },
    {
      "id": "IE-R081-COMMON-DEV-SETUP-AND-CODING-RULES",
      "proposition": "Das Team soll die Entwicklungsumgebung installieren und sp\u00E4ter gemeinsame Programmier- bzw. Kommentarregeln kl\u00E4ren.",
      "status": "desired",
      "modality": "must_consider",
      "scope": "entwicklungsprozess setup und coding rules",
      "segments": [
        112
      ]
    },
    {
      "id": "IE-R082-FLUTTER-DART-EXACT-VERSIONS",
      "proposition": "F\u00FCr Flutter und Dart wurden konkrete Versionen genannt, und alle Teammitglieder sollen dieselben Versionen installieren.",
      "status": "decided",
      "modality": "must",
      "scope": "entwicklungsprozess versionierung konkrete versionen",
      "segments": [
        101
      ]
    },
    {
      "id": "IE-R083-JETX-PACKAGE-CONSIDERED",
      "proposition": "Das JetX Package wurde als m\u00F6glicher Entwicklungsbaustein vorgeschlagen und soll zun\u00E4chst in die Rahmenbedingungen aufgenommen und gepr\u00FCft werden.",
      "status": "open",
      "modality": "must_consider",
      "scope": "technischer baustein jetx package",
      "segments": [
        113,
        114
      ]
    },
    {
      "id": "IE-R085-LOGIN-LOGO-BRANDING",
      "proposition": "Der Login-Screen soll ein prominent platziertes, rundes Logo mit Bezug zu Kommunikation enthalten; das Logo muss noch erstellt werden.",
      "status": "desired",
      "modality": "desired",
      "scope": "login branding",
      "segments": [
        116
      ]
    },
    {
      "id": "IE-R086-LOGIN-FIELDS-LAYOUT",
      "proposition": "E-Mail- und Passwortfeld sollen direkt unter dem Logo angeordnet und intuitiv benutzerfreundlich gestaltet werden.",
      "status": "desired",
      "modality": "desired",
      "scope": "login formular layout",
      "segments": [
        117
      ]
    },
    {
      "id": "IE-R087-LOGIN-SCREEN-COMPOSITION",
      "proposition": "Der Login-Screen besteht aus Logo, E-Mail-Feld, Passwort-Feld und hervorgehobenem Login-Button; eine Registrierung soll auf diesem Screen nicht angeboten werden.",
      "status": "decided",
      "modality": "must",
      "scope": "login screen zusammensetzung",
      "segments": [
        118
      ]
    },
    {
      "id": "IE-R088-PROFILE-LIST-CARDS",
      "proposition": "Profile sollen in der Profil\u00FCbersicht als Kacheln oder Liste mit Vorschaubild, Name und Kurzbeschreibung angezeigt werden.",
      "status": "desired",
      "modality": "desired",
      "scope": "profil\u00FCbersicht darstellung",
      "segments": [
        121
      ]
    },
    {
      "id": "IE-R089-ADD-PROFILE-DIALOG",
      "proposition": "Neue Profile sollen \u00FCber ein Plus-Symbol unten auf der Profil\u00FCbersicht und einen Dialog mit Bild, Name und Beschreibung angelegt werden k\u00F6nnen.",
      "status": "desired",
      "modality": "desired",
      "scope": "profil anlegen dialog",
      "segments": [
        122
      ]
    },
    {
      "id": "IE-R090-PROFILE-DETAIL-MAIN-BUTTONS",
      "proposition": "Die Profil-Detailansicht soll das gew\u00E4hlte Profilbild gr\u00F6\u00DFer zeigen und die Hauptbereiche der App als interaktive Buttons darstellen.",
      "status": "desired",
      "modality": "desired",
      "scope": "profil detailnavigation",
      "segments": [
        123
      ]
    },
    {
      "id": "IE-R091-COMMUNICATION-SYMBOLS",
      "proposition": "Die Kommunikationsseite soll verbale und nonverbale Kommunikation visuell getrennt mit Symbolen kennzeichnen und klare Bereichsbuttons haben.",
      "status": "desired",
      "modality": "desired",
      "scope": "kommunikationsseite visuelle trennung",
      "segments": [
        125
      ]
    },
    {
      "id": "IE-R092-NOGO-VISUAL-SCREEN",
      "proposition": "Der No-Go-Screen soll klare Richtlinien, ein starkes visuelles Symbol und leicht durchsuchbare bzw. durchsichtige Eintr\u00E4ge mit den wichtigsten Informationen bieten.",
      "status": "desired",
      "modality": "desired",
      "scope": "no-go screen design",
      "segments": [
        127
      ]
    },
    {
      "id": "IE-R093-CALENDAR-ICONS-TAGS",
      "proposition": "Medikamentenerinnerungen oder Kalendereintr\u00E4ge sollen in der Monatsansicht mit kleinen Icons oder Tags markiert werden k\u00F6nnen.",
      "status": "desired",
      "modality": "desired",
      "scope": "kalender visuelle marker",
      "segments": [
        128
      ]
    },
    {
      "id": "IE-R094-ACCESSIBLE-INTUITIVE-DESIGN-GOAL",
      "proposition": "Das Designziel ist eine zug\u00E4ngliche, intuitive App mit klarem Branding, ausreichenden Hilfe-Funktionen und starkem Fokus auf Benutzerfreundlichkeit.",
      "status": "desired",
      "modality": "desired",
      "scope": "ux zielbild",
      "segments": [
        135
      ]
    },
    {
      "id": "IE-R095-HELP-FIRST-LOGIN-TOUR",
      "proposition": "Eine kurze Tour beim ersten Login und ein dauerhaft aufrufbarer Hilfebereich sollen Nutzern die App-Funktionen erkl\u00E4ren.",
      "status": "desired",
      "modality": "desired",
      "scope": "hilfe und onboarding",
      "segments": [
        131
      ]
    },
    {
      "id": "IE-R096-BEWOHNER-HANDOFF-COMMUNICATION",
      "proposition": "Ein Bewohner-Account k\u00F6nnte erm\u00F6glichen, dass der Bewohner sein Ger\u00E4t mit der App an andere Personen weitergibt, falls Kommunikation fehlschl\u00E4gt.",
      "status": "desired",
      "modality": "desired",
      "scope": "bewohner-account nutzungsszenario kommunikationshilfe",
      "segments": [
        78
      ]
    },
    {
      "id": "IE-R097-RESIDENT-ACCOUNT-MISUSE-RISK",
      "proposition": "Der Bewohner-Account muss auf wenige spezifische Funktionen beschr\u00E4nkt sein, um Fehlbedienungen zu minimieren.",
      "status": "desired",
      "modality": "must_consider",
      "scope": "bewohner-account fehlbedienungsrisiko",
      "segments": [
        82
      ]
    },
    {
      "id": "IE-R099-APPBAR-TITLE-SEARCH-LAYOUT",
      "proposition": "Nach dem Login soll die Profil\u00FCbersicht unter der Appbar eine gut sichtbare Suchleiste anzeigen; der aktuelle Screen-Titel steht in der Appbar.",
      "status": "desired",
      "modality": "desired",
      "scope": "appbar und profil\u00FCbersicht layout",
      "segments": [
        120
      ]
    }
