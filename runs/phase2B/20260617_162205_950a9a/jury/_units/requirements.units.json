  "units": [
    {
      "Index": 0,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Kundenportal: Kunden k\u00F6nnen Angebote, Bestellungen und Rechnungen einsehen und als PDF herunterladen.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 1,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Login: Authentifizierung per E\u2011Mail \u002B Passwort mit Double\u2011Opt\u2011In; optionale SSO\u2011Integration (Azure AD, Google) wird im MVP nicht umgesetzt.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 2,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Rollen \u0026 Berechtigungen: Rollen Admin, Sales, Manager, Support. Support\u2011Mitarbeiter d\u00FCrfen Kundendaten einsehen, jedoch keine Preis\u2011/Rabatt\u2011Details.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 3,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Angebots\u2011Workflow: Zust\u00E4nde Draft \u2192 Pending Approval \u2192 Approved \u2192 Sent. Freigabe erforderlich bei Rabatt \u003E 15 % (Schwellenwert muss noch best\u00E4tigt werden).",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 4,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "SAP\u2011Integration: Lesezugriff auf Produkt\u2011 und Preisdaten aus SAP; Schreibzugriff (Auftragserstellung) ist f\u00FCr sp\u00E4tere Phasen vorgesehen.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 5,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "PDF\u2011Export: Rechtlich konforme PDF\u2011Erstellung mit Fu\u00DFnoten f\u00FCr Angebote und Rechnungen.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 6,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Mehrw\u00E4hrung: Unterst\u00FCtzte W\u00E4hrungen EUR (Standard) und CHF (Pilotkunde); USD sp\u00E4ter.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 7,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Analytics/KPIs: Erfassung von Conversion\u2011Rate, Zeit bis Angebot, Nutzung\u2011Statistiken; Consent\u2011Management f\u00FCr Tracking ist erforderlich.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 8,
      "Section": "Functional Requirements",
      "Kind": "bullet",
      "Text": "Support\u2011Kontakt: Kontaktformular f\u00FCr Kunden; kein Ticket\u2011System im MVP.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 9,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
      "Text": "DSGVO\u2011Konformit\u00E4t: Double\u2011Opt\u2011In, umfassendes Logging, Audit\u2011Trail, L\u00F6schkonzept, Datenminimierung.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 10,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
      "Text": "Security: TLS\u2011Verschl\u00FCsselung, grunds\u00E4tzlicher Security Review (Detail\u2011Review ggf. nach MVP).",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 11,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
      "Text": "Hosting \u0026 Infrastruktur: EU\u2011only Managed Service, keine eigene Datenbank, Backup \u0026 Disaster Recovery inkl..",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 12,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
      "Text": "Performance: API\u2011Gateway (Verf\u00FCgbarkeit nach 6\u2011Wochen\u2011Warteliste), Rate\u2011Limiting und Pagination f\u00FCr Downloads.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 13,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
      "Text": "Availability: Ziel\u2011Uptime 99,5 % (Annahme).",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 14,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
      "Text": "Monitoring: Trennung von technischen Logs und Audit\u2011Logs, festgelegte Aufbewahrungsfristen.",
      "Cells": null,
      "LikelyNonClaim": false
    },
    {
      "Index": 15,
      "Section": "Non-functional Requirements",
      "Kind": "bullet",
