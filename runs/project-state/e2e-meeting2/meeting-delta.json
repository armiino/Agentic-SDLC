      "pbi": null
    },
    {
      "itemId": "REQ-02",
      "itemType": "requirement",
      "text": "F\u00FCr die No-Go-Seite soll ein rotes Stopp-Symbol als deutliches Warnsignal erg\u00E4nzt werden, damit sofort erkennbar ist, dass die Inhalte kritisch sind. Dieser Punkt ist noch offen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
