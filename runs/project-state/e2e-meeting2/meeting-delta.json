      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-12",
      "itemType": "requirement",
      "text": "Einsicht in das Zugriffsprotokoll d\u00FCrfen nur Admins haben; normale Nutzer d\u00FCrfen dieses Protokoll nicht einsehen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
