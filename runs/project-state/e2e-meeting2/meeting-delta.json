      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-05",
      "itemType": "requirement",
      "text": "Der Sofortinfo-Bereich in der Profil-Detailansicht muss auf maximal f\u00FCnf Eintr\u00E4ge begrenzt werden.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
