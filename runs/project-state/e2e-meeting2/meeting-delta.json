        "producerModel": "openai/gpt-5.4"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-10",
      "itemType": "requirement",
      "text": "\u00DCbergabe-Notizen sollen nach sieben Tagen automatisch archiviert werden; archivierte Notizen m\u00FCssen jedoch weiterhin auffindbar bleiben. Dieser Punkt ist noch offen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
