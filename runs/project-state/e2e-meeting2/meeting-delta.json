      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-11",
      "itemType": "requirement",
      "text": "Jede Einsichtnahme in Bewohnerdaten muss revisionssicher protokolliert werden, einschlie\u00DFlich wer wann welches Profil angesehen hat.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "zugriffsprotokoll-pflicht-revisionssicher-adminsicht"
