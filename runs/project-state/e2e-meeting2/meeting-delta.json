      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-08",
      "itemType": "requirement",
      "text": "Es besteht der Bedarf nach einer \u00DCbergabe-Notiz pro Schicht, die der n\u00E4chsten Schicht beim \u00D6ffnen der App prominent angezeigt wird. Dieser Punkt ist noch offen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "uebergabe-notizen-schichtworkflow"
      ],
      "sourceArtifactItemIds": [],
