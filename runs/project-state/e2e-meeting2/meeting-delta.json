  "items": [
    {
      "itemId": "REQ-01",
      "itemType": "requirement",
      "text": "No-Go-Eintr\u00E4ge m\u00FCssen pro Bewohner gef\u00FChrt werden und d\u00FCrfen nicht global f\u00FCr alle Bewohner gelten.",
