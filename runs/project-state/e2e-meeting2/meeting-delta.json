        "artifactVersion": "1",
        "producerModel": "openai/gpt-5.4"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-09",
      "itemType": "requirement",
      "text": "F\u00FCr \u00DCbergabe-Notizen besteht der Bedarf, sie bewohnerbezogen verlinkbar zu machen, sodass direkt auf das Profil eines Bewohners verwiesen werden kann. Dieser Punkt ist noch offen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "uebergabe-notizen-bewohnerverlinkung"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
