        "producerModel": "openai/gpt-5.4"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-04",
      "itemType": "requirement",
      "text": "F\u00FCr die Anlage von No-Gos kann optional eine Vorlagen-Liste mit h\u00E4ufigen No-Gos angeboten werden; daraus darf jedoch nichts automatisch global gelten.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
