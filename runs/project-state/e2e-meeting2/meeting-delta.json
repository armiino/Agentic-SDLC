      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-07",
      "itemType": "requirement",
      "text": "Es muss eine Suche nach Stichworten \u00FCber alle Bewohnerprofile hinweg geben. Der Umsetzungszeitpunkt ist noch nicht pr\u00E4zisiert.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260723_134102_c63c89",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
