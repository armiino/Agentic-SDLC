{
  "runId": "20260905_184204_3cfc38",
  "source": "meeting-2-extended.txt",
  "model": "openai/gpt-5.4",
  "variant": "F_mission_v2",
  "statements": [
    {
      "id": "C-001",
      "statement": "Die bestehende About-Me-Seite soll inhaltlich unver\u00E4ndert bleiben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0004"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-002",
      "statement": "Die No-Go-Seite soll ein rotes Stopp-Symbol als deutliches Warnsignal anzeigen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0006"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-003",
      "statement": "Eintr\u00E4ge auf der No-Go-Seite m\u00FCssen nachtr\u00E4glich bearbeitet werden k\u00F6nnen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0007"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-004",
      "statement": "Eintr\u00E4ge auf der No-Go-Seite m\u00FCssen gel\u00F6scht werden k\u00F6nnen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0007"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-005",
      "statement": "No-Gos bleiben bewohnerbezogen und gelten nicht global f\u00FCr alle Bewohner.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0009"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-006",
      "statement": "Beim Anlegen von No-Gos soll eine Vorlagen-Liste mit h\u00E4ufigen No-Gos zur Auswahl angeboten werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0009"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-007",
      "statement": "Ein Eintrag aus der Vorlagen-Liste f\u00FCr No-Gos darf nicht automatisch global f\u00FCr alle Bewohner gelten.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0009"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-008",
      "statement": "Der Sofortinfo-Bereich auf der Profil-Detailansicht soll auf maximal f\u00FCnf Eintr\u00E4ge begrenzt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0012"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-009",
      "statement": "Beim Anlegen eines Bewohners muss mindestens ein Sofortinfo-Eintrag verpflichtend erfasst werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0012"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-010",
      "statement": "Noch nicht synchronisierte offline erfasste Inhalte m\u00FCssen f\u00FCr den Nutzer erkennbar sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0014"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-011",
      "statement": "Wenn zwei Personen denselben Eintrag offline ge\u00E4ndert haben, muss eine klare Konfliktanzeige angezeigt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0014",
        "AU-0015"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-012",
      "statement": "Bei Offline-Konflikten darf nichts stillschweigend \u00FCberschrieben werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0014"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-013",
      "statement": "Bei Offline-Konflikten soll der Nutzer entscheiden, welche Version gilt.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0015"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-014",
      "statement": "Es muss pro Schicht eine \u00DCbergabe-Notiz geben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0016"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-015",
      "statement": "Die \u00DCbergabe-Notiz einer Schicht muss der n\u00E4chsten Schicht beim \u00D6ffnen der App prominent angezeigt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0016"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-016",
      "statement": "\u00DCbergabe-Notizen m\u00FCssen mit Bewohnerprofilen verlinkbar sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0017"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-017",
      "statement": "\u00DCbergabe-Notizen sollen nach sieben Tagen automatisch archiviert werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0018"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-018",
      "statement": "Archivierte \u00DCbergabe-Notizen m\u00FCssen auffindbar bleiben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0018"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-019",
      "statement": "Es soll eine Suche \u00FCber alle Bewohnerprofile hinweg nach Stichworten geben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0019"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-020",
      "statement": "Die Suche \u00FCber Bewohnerprofile soll Anwendungsf\u00E4lle wie die Suche nach Nahrungsmitteln in No-Gos unterst\u00FCtzen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0019"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-021",
      "statement": "Jede Einsichtnahme in Bewohnerdaten muss protokolliert werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-022",
      "statement": "Das Zugriffsprotokoll muss erfassen, wer wann welches Profil angesehen hat.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-023",
      "statement": "Ohne Protokollierung der Einsichtnahmen darf die App nicht eingesetzt werden.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-024",
      "statement": "Das Zugriffsprotokoll muss revisionssicher sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0022"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-025",
      "statement": "Das Zugriffsprotokoll d\u00FCrfen nur Admins einsehen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0023"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-026",
      "statement": "Normale Nutzer d\u00FCrfen das Zugriffsprotokoll nicht einsehen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0023"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-027",
      "statement": "Es ist offen, ob Angeh\u00F6rige selbst Inhalte eintragen d\u00FCrfen oder nur lesen d\u00FCrfen.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0024",
        "AU-0025"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-028",
      "statement": "Die Frage, ob Angeh\u00F6rige Inhalte eintragen d\u00FCrfen, muss mit der Datenschutzbeauftragten gekl\u00E4rt werden.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0025"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-029",
      "statement": "Bis zur Kl\u00E4rung bleibt die Entscheidung \u00FCber Schreibrechte f\u00FCr Angeh\u00F6rige unentschieden.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0025"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-030",
      "statement": "Ein Dunkelmodus ist als Wunsch f\u00FCr den Nachtdienst vorgesehen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0027",
        "AU-0028"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-031",
      "statement": "Eine einstellbare Schriftgr\u00F6\u00DFe ist als Wunsch zur Unterst\u00FCtzung \u00E4lterer Kolleginnen vorgesehen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0027",
        "AU-0028"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-032",
      "statement": "Dunkelmodus und einstellbare Schriftgr\u00F6\u00DFe haben niedrigere Priorit\u00E4t als die anderen Punkte.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0028"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-033",
      "statement": "Firebase Firestore wird endg\u00FCltig als Datenbankl\u00F6sung beibehalten.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0029",
        "AU-0030"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-034",
      "statement": "Die Diskussion \u00FCber Alternativen zu Firebase Firestore wird nicht wieder aufgenommen.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0029"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-035",
      "statement": "Als Mindestanforderung werden Android-Ger\u00E4te ab Version 10 unterst\u00FCtzt.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0031",
        "AU-0032"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-036",
      "statement": "Wenn \u00E4ltere Ger\u00E4te als Android 10 im Haus vorhanden sind, m\u00FCssen sie ausgetauscht werden.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0031"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-037",
      "statement": "Das Thema Piktogramme muss k\u00FCnftig breiter gedacht werden, ist aber noch nicht konkret genug definiert.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0033",
        "AU-0034"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    }
  ],
