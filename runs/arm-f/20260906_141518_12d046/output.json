{
  "runId": "20260906_141518_12d046",
  "source": "meeting-2-extended.txt",
  "model": "openai/gpt-5.4",
  "variant": "F_mission_v2",
  "statements": [
    {
      "id": "C-001",
      "statement": "Die About-Me-Seite soll unver\u00E4ndert bleiben.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0004"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-002",
      "statement": "Die No-Go-Seite soll ein rotes Stopp-Symbol als deutliches Warnsignal anzeigen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0006"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-003",
      "statement": "Eintr\u00E4ge auf der No-Go-Seite m\u00FCssen nachtr\u00E4glich bearbeitet werden k\u00F6nnen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0007"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-004",
      "statement": "Eintr\u00E4ge auf der No-Go-Seite m\u00FCssen gel\u00F6scht werden k\u00F6nnen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0007"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-005",
      "statement": "No-Gos bleiben pro Bewohner und gelten nicht global f\u00FCr alle Bewohner.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0009"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-006",
      "statement": "Beim Anlegen von No-Gos soll eine Vorlagen-Liste mit h\u00E4ufigen No-Gos zur Auswahl angeboten werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0009"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-007",
      "statement": "Aus einer Vorlagen-Liste ausgew\u00E4hlte No-Gos gelten nicht automatisch global f\u00FCr alle Bewohner.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0009"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-008",
      "statement": "Der Sofortinfo-Bereich auf der Profil-Detailansicht soll auf maximal f\u00FCnf Eintr\u00E4ge begrenzt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0012"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-009",
      "statement": "Beim Anlegen eines Bewohners muss mindestens ein Sofortinfo-Eintrag verpflichtend sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0012"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-010",
      "statement": "Noch nicht synchronisierte offline erfasste Inhalte m\u00FCssen f\u00FCr den Nutzer erkennbar sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0014"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-011",
      "statement": "Wenn zwei Nutzer denselben Eintrag offline ge\u00E4ndert haben, muss eine klare Konfliktanzeige angezeigt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0014",
        "AU-0015"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-012",
      "statement": "Bei Offline-Konflikten darf nichts stillschweigend \u00FCberschrieben werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0014"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-013",
      "statement": "Bei Offline-Konflikten soll der Nutzer entscheiden, welche Version gilt.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0015"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-014",
      "statement": "Es muss pro Schicht eine \u00DCbergabe-Notiz geben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0016"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-015",
      "statement": "Die \u00DCbergabe-Notiz einer Schicht muss der n\u00E4chsten Schicht beim \u00D6ffnen der App prominent angezeigt werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0016"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-016",
      "statement": "\u00DCbergabe-Notizen m\u00FCssen bewohnerbezogen verlinkbar sein.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0017"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-017",
      "statement": "\u00DCbergabe-Notizen sollen nach sieben Tagen automatisch archiviert werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0018"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-018",
      "statement": "Archivierte \u00DCbergabe-Notizen m\u00FCssen auffindbar bleiben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0018"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-019",
      "statement": "Es soll eine Suche \u00FCber alle Bewohnerprofile hinweg nach Stichworten geben.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0019"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-020",
      "statement": "Die Suche soll Anwendungsf\u00E4lle wie das Finden von Bewohnern anhand von No-Go-Stichworten unterst\u00FCtzen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0019"
      ],
      "derivation": "derived",
      "uncertainty": "none"
    },
    {
      "id": "C-021",
      "statement": "Jede Einsichtnahme in Bewohnerdaten muss protokolliert werden.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-022",
      "statement": "Das Zugriffsprotokoll muss erfassen, wer welches Profil wann angesehen hat.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-023",
      "statement": "Das Zugriffsprotokoll ist verpflichtend, weil die Heimaufsicht dies als Auflage verlangt.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-024",
      "statement": "Ohne Umsetzung des Zugriffsprotokolls darf die App nicht eingesetzt werden.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0021"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-025",
      "statement": "Das Zugriffsprotokoll muss revisionssicher sein.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0022"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-026",
      "statement": "Das Zugriffsprotokoll d\u00FCrfen nur Admins einsehen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0023"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-027",
      "statement": "Normale Nutzer d\u00FCrfen das Zugriffsprotokoll nicht einsehen.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0023"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-028",
      "statement": "Ob Angeh\u00F6rige selbst Inhalte eintragen oder nur lesen d\u00FCrfen, ist noch offen.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0024",
        "AU-0025"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-029",
      "statement": "Die Entscheidung \u00FCber Bearbeitungsrechte von Angeh\u00F6rigen wird wegen Datenschutzfragen mit der Datenschutzbeauftragten gekl\u00E4rt.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0025"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-030",
      "statement": "Bis zur Kl\u00E4rung bleibt die Frage der Bearbeitungsrechte von Angeh\u00F6rigen unentschieden.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0025"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-031",
      "statement": "Ein Dunkelmodus ist als Wunsch erfasst, hat aber keine hohe Priorit\u00E4t.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0027",
        "AU-0028"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-032",
      "statement": "Eine einstellbare Schriftgr\u00F6\u00DFe ist als Wunsch erfasst, hat aber keine hohe Priorit\u00E4t.",
      "type": "requirement",
      "sourceUnitIds": [
        "AU-0027",
        "AU-0028"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-033",
      "statement": "Firebase Firestore wird endg\u00FCltig als L\u00F6sung beibehalten.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0029",
        "AU-0030"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-034",
      "statement": "Die Diskussion \u00FCber Alternativen zu Firebase Firestore wird nicht wieder aufgenommen.",
      "type": "decision",
      "sourceUnitIds": [
        "AU-0029"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "id": "C-035",
      "statement": "Als Mindestanforderung werden Android-Ger\u00E4te ab Version 10 unterst\u00FCtzt.",
      "type": "architecture",
      "sourceUnitIds": [
        "AU-0031",
        "AU-0032"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-036",
      "statement": "\u00C4ltere Ger\u00E4te als Android 10 m\u00FCssten ausgetauscht werden.",
      "type": "risk",
      "sourceUnitIds": [
        "AU-0031"
      ],
      "derivation": "explicit",
      "uncertainty": "uncertain"
    },
    {
      "id": "C-037",
      "statement": "Der Punkt zu Piktogrammen ist fachlich noch nicht konkret genug und bleibt offen.",
      "type": "open_question",
      "sourceUnitIds": [
        "AU-0033",
        "AU-0034"
      ],
      "derivation": "derived",
      "uncertainty": "uncertain"
    }
  ],
