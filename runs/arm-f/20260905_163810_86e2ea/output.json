      "sourceUnitIds": [
        "AU-0001"
      ],
      "derivation": "explicit",
      "uncertainty": "none"
    },
    {
      "statement": "Es wird eine L\u00F6sung gesucht, die die Kommunikation zwischen beeintr\u00E4chtigten Personen und anderen Menschen verbessert und f\u00F6rdert.",
