    {
      "itemId": "REQ-03",
      "itemType": "requirement",
      "text": "Pro Schicht ist eine Schicht\u00FCbergabe-Notiz zu erfassen, die der jeweils n\u00E4chsten Schicht angezeigt wird, um die Informationsweitergabe zwischen den Schichten zu verbessern.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
