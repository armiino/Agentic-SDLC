    {
      "itemId": "REQ-02",
      "itemType": "requirement",
      "text": "No-Go-Eintr\u00E4ge m\u00FCssen nachtr\u00E4glich sowohl bearbeitet als auch gel\u00F6scht werden k\u00F6nnen, um Datenpflege und Korrekturen zu erm\u00F6glichen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
