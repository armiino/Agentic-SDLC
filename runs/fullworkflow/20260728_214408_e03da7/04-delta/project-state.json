    {
      "itemId": "REQ-12",
      "itemType": "requirement",
      "text": "Bei konkurrierenden Offline-\u00C4nderungen am selben Eintrag m\u00FCssen Konflikte angezeigt werden; es darf nichts stillschweigend \u00FCberschrieben werden.",
      "status": "baseline",
