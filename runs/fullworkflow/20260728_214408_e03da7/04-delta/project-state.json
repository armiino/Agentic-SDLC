        "producerModel": "openai/gpt-5.4"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-04",
      "itemType": "requirement",
      "text": "Beim Anlegen von No-Gos muss eine Vorlagen-Liste mit h\u00E4ufigen No-Gos zur Auswahl bereitstehen; aus dieser Vorlagen-Liste darf nichts automatisch global gelten.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "no-go-vorlagenliste"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
        "artifactVersion": "1",
        "producerModel": "openai/gpt-5.4"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-05",
      "itemType": "requirement",
      "text": "Eintr\u00E4ge auf der No-Go-Seite m\u00FCssen nachtr\u00E4glich bearbeitet und gel\u00F6scht werden k\u00F6nnen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
