      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-09",
      "itemType": "requirement",
      "text": "\u00DCbergabe-Notizen sollen nach sieben Tagen automatisch archiviert werden; archivierte Notizen m\u00FCssen weiterhin auffindbar bleiben.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
