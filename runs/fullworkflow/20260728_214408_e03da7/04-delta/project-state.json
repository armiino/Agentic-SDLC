      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-02",
      "itemType": "requirement",
      "text": "Die No-Go-Seite muss ein rotes Stopp-Symbol als deutliches Warnsignal anzeigen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
