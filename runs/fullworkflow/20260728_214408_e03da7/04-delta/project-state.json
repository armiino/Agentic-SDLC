    },
    {
      "itemId": "REQ-13",
      "itemType": "requirement",
      "text": "Eine einstellbare Schriftgr\u00F6\u00DFe ist als Wunsch vorgesehen und kann sp\u00E4ter ber\u00FCcksichtigt werden; sie hat keine hohe Priorit\u00E4t.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
