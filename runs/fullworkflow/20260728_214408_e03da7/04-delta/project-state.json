    {
      "itemId": "REQ-01",
      "itemType": "requirement",
      "text": "Die bestehende Gestaltung der About-Me-Seite darf nicht ge\u00E4ndert werden und soll unver\u00E4ndert bleiben.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
