        "producerModel": "openai/gpt-5.4"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-08",
      "itemType": "requirement",
      "text": "\u00DCbergabe-Notizen m\u00FCssen bewohnerbezogen verlinkbar sein, sodass direkt auf ein Bewohnerprofil verwiesen werden kann.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
