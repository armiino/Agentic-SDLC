      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-07",
      "itemType": "requirement",
      "text": "Es muss pro Schicht eine \u00DCbergabe-Notiz geben, die der n\u00E4chsten Schicht beim \u00D6ffnen der App prominent angezeigt wird.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "uebergabe-notiz-pro-schicht"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
