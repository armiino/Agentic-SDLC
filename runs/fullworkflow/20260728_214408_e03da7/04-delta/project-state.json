      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-03",
      "itemType": "requirement",
      "text": "No-Gos d\u00FCrfen nicht global f\u00FCr alle Bewohner gelten, sondern m\u00FCssen pro Bewohner gef\u00FChrt werden.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "no-gos-pro-bewohner"
      ],
      "sourceArtifactItemIds": [],
