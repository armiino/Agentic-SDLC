      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-06",
      "itemType": "requirement",
      "text": "Beim Anlegen eines Bewohners muss mindestens ein Sofortinfo-Eintrag verpflichtend erfasst werden.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260728_215053_d785e1",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "sofortinfo-mindestens-eins"
      ],
      "sourceArtifactItemIds": [],
