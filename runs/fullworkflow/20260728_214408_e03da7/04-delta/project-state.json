    },
    {
      "itemId": "REQ-14",
      "itemType": "requirement",
      "text": "Ein Dunkelmodus ist als Wunsch vorgesehen, insbesondere f\u00FCr den Nachtdienst; der Zeithorizont ist unklar und die Priorit\u00E4t ist niedrig.",
      "status": "baseline",
