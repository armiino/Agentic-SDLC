  "items": [
    {
      "itemId": "REQ-01",
      "itemType": "requirement",
      "text": "Die No-Go-Seite muss weiterhin einen Plus-Button enthalten, mit dem neue Eintr\u00E4ge als Liste hinzugef\u00FCgt werden k\u00F6nnen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_142227_fc9295",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "CAN-0001"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
        "artifactVersion": "1",
        "producerModel": "openai/gpt-4.1-mini"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-02",
      "itemType": "requirement",
      "text": "Die No-Go-Seite muss ein rotes Stopp-Symbol als deutliches Warnsignal anzeigen, um die Aufmerksamkeit der Nutzerinnen und Nutzer zu erh\u00F6hen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_142227_fc9295",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "CAN-0002"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
        "artifactVersion": "1",
        "producerModel": "openai/gpt-4.1-mini"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-03",
      "itemType": "requirement",
      "text": "Es muss m\u00F6glich sein, bestehende No-Go-Eintr\u00E4ge nachtr\u00E4glich zu bearbeiten und zu l\u00F6schen, um Korrekturen und Anpassungen zu erm\u00F6glichen.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_142227_fc9295",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "CAN-0003"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
        "artifactVersion": "1",
        "producerModel": "openai/gpt-4.1-mini"
      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-04",
      "itemType": "requirement",
      "text": "F\u00FCr jede Schicht ist eine Schicht\u00FCbergabe-Notiz zu erstellen, die der unmittelbar folgenden Schicht zur Verf\u00FCgung gestellt wird, um den Informationsfluss zwischen den Schichten zu verbessern.",
      "status": "baseline",
      "origin": "Extracted",
      "stage": "evidence_baseline",
      "version": 1,
      "sourceRunId": "20260725_142227_fc9295",
      "sourceArtifactId": "REQ",
      "sourceArtifactType": "requirements",
      "sourceDecisionId": null,
      "sourceCandidateId": null,
      "sourceClaimIds": [
        "CAN-0004"
      ],
      "sourceArtifactItemIds": [],
      "metadata": {
