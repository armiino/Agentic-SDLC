      },
      "identityKey": null,
      "history": null,
      "feature": null,
      "pbi": null
    },
    {
      "itemId": "REQ-05",
      "itemType": "requirement",
      "text": "Es ist zu kl\u00E4ren, ob No-Gos global f\u00FCr alle Bewohner gelten sollen oder jeweils nur f\u00FCr einzelne Bewohner.",
      "status": "baseline",
